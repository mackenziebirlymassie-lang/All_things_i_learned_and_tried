{
  "name": "flowforge-cli",
  "version": "1.0.0",
  "description": "Pure JavaScript local task and workflow automation CLI",
  "main": "src/index.js",
  "bin": { "flowforge": "src/cli/main.js" },
  "scripts": { "start": "node src/cli/main.js", "test": "node --test", "lint": "powershell -NoProfile -Command \"Get-ChildItem -Recurse -Filter *.js | ForEach-Object { node --check $_.FullName }\"", "count": "powershell -NoProfile -Command \"$n=0; Get-ChildItem -Recurse -Filter *.js | ForEach-Object { $n += (Get-Content $_.FullName).Count }; Write-Output $n\"", "demo": "node src/cli/main.js demo" },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
